# Shared during MCP client server handshake initialization
GATEWAY_NAME=mcp-gateway
GATEWAY_VERSION=1.0.0

## http (remote clients) or stdio (a local app starts the gateway); --transport overrides it
GATEWAY_TRANSPORT=http
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_PATH=/mcp/gateway

## comma-separated host:port clients use to reach the gateway; empty = localhost only when HOST is 127.0.0.1, any Host otherwise
GATEWAY_ALLOWED_HOSTS=
GATEWAY_LOG_LEVEL=INFO
GATEWAY_AUTH_ENABLED=true  # Must send CLIENT TO GATEWAY api keys

## reconnect to a down server: first wait, doubling up to the max (seconds)
GATEWAY_RECONNECT_INITIAL_DELAY=1
GATEWAY_RECONNECT_MAX_DELAY=60

## timers (seconds)
### at startup, wait this long for servers before accepting clients
GATEWAY_STARTUP_CONNECT_TIMEOUT=10
### how often each server is health-checked and re-listed
GATEWAY_HEALTH_CHECK_INTERVAL=30
### how old the catalog may get before a list request re-fetches it
GATEWAY_CATALOG_TTL=30
### wait after a change notification, so a burst of changes becomes one refresh
GATEWAY_CHANGE_DEBOUNCE=1
### close a client's own server session after this long unused
GATEWAY_CLIENT_SESSION_IDLE=300


##########################################################################
########################CLIENT TO GATEWAY################################
##########################################################################


## admin level keys - any client can use any servers
API_KEY_ADMIN=your-admin-key

## group level keys - a key for one or more servers
API_KEY_GROUP_1=your-group_1-key
API_KEY_GROUP_1_SERVERS=server_1

API_KEY_GROUP_2=your-group_2-key
API_KEY_GROUP_2_SERVERS=server_2

API_KEY_GROUP_3=your-group_3-key
API_KEY_GROUP_3_SERVERS=server_3

API_KEY_GROUP_4=your-group_4-key
API_KEY_GROUP_4_SERVERS=server_4

API_KEY_GROUP_5=your-group_5-key
API_KEY_GROUP_5_SERVERS=server_1, server_2

API_KEY_GROUP_6=your-group_6-key
API_KEY_GROUP_6_SERVERS=server_2, server_3

API_KEY_GROUP_7=your-group_7-key
API_KEY_GROUP_7_SERVERS=server_3, server_4

API_KEY_GROUP_8=your-group_8-key
API_KEY_GROUP_8_SERVERS=server_1, server_4

API_KEY_GROUP_9=your-group_9-key
API_KEY_GROUP_9_SERVERS=server_1, server_2, server_3

API_KEY_GROUP_10=your-group_10-key
API_KEY_GROUP_10_SERVERS=server_1, server_2, server_4

API_KEY_GROUP_11=your-group_11-key
API_KEY_GROUP_11_SERVERS=server_1, server_3, server_4

API_KEY_GROUP_12=your-group_12-key
API_KEY_GROUP_12_SERVERS=server_1, server_2, server_3, server_4

API_KEY_GROUP_13=your-group_13-key
API_KEY_GROUP_13_SERVERS=server_5_sse

API_KEY_GROUP_14=your-group_14-key
API_KEY_GROUP_14_SERVERS=server_3, server_5_sse

# GATEWAY TO SERVER
## every server needs all six settings (they mirror the server table's columns)

SERVER_1_URL=http://127.0.0.1:9001/mcp
SERVER_1_TRANSPORT=streamable_http
SERVER_1_TIMEOUT=60
SERVER_1_ENABLED=true
SERVER_1_INCLUDE_TOOLS=*
SERVER_1_EXCLUDE_TOOLS=delete_everything, whoami, echo

SERVER_2_URL=http://127.0.0.1:9002/mcp
SERVER_2_TRANSPORT=streamable_http
SERVER_2_TIMEOUT=60
SERVER_2_ENABLED=true
SERVER_2_INCLUDE_TOOLS=*
SERVER_2_EXCLUDE_TOOLS=

SERVER_3_URL=http://127.0.0.1:9003/mcp
SERVER_3_TRANSPORT=streamable_http
SERVER_3_TIMEOUT=60
SERVER_3_ENABLED=true
SERVER_3_INCLUDE_TOOLS=*
SERVER_3_EXCLUDE_TOOLS=

# deployed server (Cloud Foundry)
SERVER_4_URL=https://dummy-math-server.cfapps.us10-001.hana.ondemand.com/mcp/math_tools
SERVER_4_TRANSPORT=streamable_http
SERVER_4_TIMEOUT=60
SERVER_4_ENABLED=true
SERVER_4_INCLUDE_TOOLS=*
SERVER_4_EXCLUDE_TOOLS=

# local servers/server_5/server_5.py over streamable_http
SERVER_5_URL=http://127.0.0.1:9005/mcp
SERVER_5_TRANSPORT=streamable_http
SERVER_5_TIMEOUT=60
SERVER_5_ENABLED=true
SERVER_5_INCLUDE_TOOLS=*
SERVER_5_EXCLUDE_TOOLS=

# the same local server_5, reached over SSE
SERVER_5_SSE_URL=http://127.0.0.1:9005/sse
SERVER_5_SSE_TRANSPORT=sse
SERVER_5_SSE_TIMEOUT=60
SERVER_5_SSE_ENABLED=true
SERVER_5_SSE_INCLUDE_TOOLS=*
SERVER_5_SSE_EXCLUDE_TOOLS=
