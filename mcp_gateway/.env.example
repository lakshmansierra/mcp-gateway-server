# Shared during MCP client server handshake initialization
GATEWAY_NAME=mcp-gateway
GATEWAY_VERSION=1.0.0

## http (remote clients) or stdio (a local app starts the gateway); --transport overrides it
GATEWAY_TRANSPORT=http
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_PATH=/mcp/gateway

## comma-separated host:port clients use to reach the gateway; empty = localhost only when HOST is 127.0.0.1, any Host otherwise
GATEWAY_ALLOWED_HOSTS=
GATEWAY_LOG_LEVEL=INFO
GATEWAY_AUTH_ENABLED=true  # Must send CLIENT TO GATEWAY api keys

## reconnect to a down server: first wait, doubling up to the max (seconds)
GATEWAY_RECONNECT_INITIAL_DELAY=1
GATEWAY_RECONNECT_MAX_DELAY=60

## timers (seconds)
### at startup, wait this long for servers before accepting clients
GATEWAY_STARTUP_CONNECT_TIMEOUT=10
### how often each server is health-checked and re-listed
GATEWAY_HEALTH_CHECK_INTERVAL=30
### how old the catalog may get before a list request re-fetches it
GATEWAY_CATALOG_TTL=30
### wait after a change notification, so a burst of changes becomes one refresh
GATEWAY_CHANGE_DEBOUNCE=1
### close a client's own server session after this long unused
GATEWAY_CLIENT_SESSION_IDLE=300
### re-read the servers and API keys in HANA this often, so backend changes apply without a restart
GATEWAY_DB_SYNC_INTERVAL=30

## route that answers without an API key (load balancer / Cloud Foundry health check)
GATEWAY_HEALTH_PATH=/health
## header the gateway adds to each client's own session to a server, naming the client (<user>/<key>)
GATEWAY_CLIENT_ID_HEADER=X-MCP-Client

## the backend calls POST <path> with this secret right after a change, so the gateway re-reads HANA at once;
## empty secret = off (changes then apply at the next GATEWAY_DB_SYNC_INTERVAL re-read). Same secret as backend/.env
GATEWAY_RELOAD_PATH=/internal/reload
GATEWAY_RELOAD_SECRET=

## tool usage (tools, their history, every tool call) is written to HANA in the background this often (seconds);
## while HANA can't be reached, up to BUFFER_MAX calls wait, beyond that the oldest are dropped
GATEWAY_USAGE_FLUSH_INTERVAL=5
GATEWAY_USAGE_BUFFER_MAX=10000

## seconds before a HANA call gives up (a stuck read then retries on the next re-read)
HANA_CONNECT_TIMEOUT=10
HANA_QUERY_TIMEOUT=30

# Hana db creds
HANA_HOST=
HANA_PORT=
HANA_USER=
HANA_PASSWORD=
HANA_SCHEMA=

# Hana db tables 
USER_TABLE=user_mgs
MCP_SERVER_TABLE=mcp_app_mgs
MCP_CLIENT_TO_GATEWAY_API_KEY_TABLE=client_to_gateway_mcp_api_key_mgs
MCP_CLIENT_TO_GATEWAY_API_KEY_MAPPING_TABLE=client_to_gateway_mcp_api_key_mapping_mgs
## per-server upstream auth config (the gateway reads this)
MCP_SERVER_AUTH_TABLE=mcp_server_auth_mgs
## tool usage tables (the gateway writes these)
MCP_TOOL_TABLE=tools_mgs
MCP_TOOL_CHANGE_TABLE=tool_changes_mgs
MCP_TOOL_CALL_TABLE=tool_calls_mgs
## OAuth2 access-token cache (the gateway writes this)
MCP_SERVER_TOKEN_CACHE_TABLE=mcp_server_token_cache_mgs
REVOKED_TOKEN_TABLE=revoked_token_mgs
