# Baked into the build by Vite at `npm run build` time (not read at runtime).
# Backend API (FastAPI). Its BACKEND_CORS_ORIGINS must include this frontend's URL.
VITE_API_BASE_URL=https://mcp-gateway-backend.cfapps.us10-001.hana.ondemand.com
# The gateway's MCP endpoint that clients connect to with their API key.
VITE_GATEWAY_MCP_URL=https://mcp-gateway-server.cfapps.us10-001.hana.ondemand.com/mcp/gateway
