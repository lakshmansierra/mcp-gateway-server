# Copy to .env (git-ignored). Local URLs, used by `npm run dev`.
# `npm run build` (what cf push uploads) uses the deployed URLs in .env.production instead, which override these.
# Backend API (FastAPI)
VITE_API_BASE_URL=http://127.0.0.1:8000
# The gateway's MCP endpoint that clients connect to with their API key
VITE_GATEWAY_MCP_URL=http://127.0.0.1:8080/mcp/gateway
