# Copy to .env and fill in. .env is git-ignored, so real keys and URLs stay out of git.
# Variables already set in the real environment override values in .env.

# ---- Gateway ---------------------------------------------------------------
GATEWAY_NAME=mcp-gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_PATH=/mcp
# Comma-separated hostnames clients use to reach the gateway (DNS-rebinding protection).
# Leave empty to accept any Host header (API keys are still required).
GATEWAY_ALLOWED_HOSTS=
GATEWAY_RECONNECT_INITIAL_DELAY=1
GATEWAY_RECONNECT_MAX_DELAY=60
GATEWAY_LOG_LEVEL=INFO
GATEWAY_AUTH_ENABLED=true

# ---- Client API keys ---------------------------------------------------------
# Clients send a key as "Authorization: Bearer <secret>". Two kinds:
#   API_KEY_<NAME>=<secret>   access to every server (e.g. an admin key)
#   SERVER_<ID>_KEY=<secret>  access to that one server only (see the server section below)
# Optional: API_KEY_<NAME>_SERVERS=server_1,server_2 limits an API_KEY_<NAME> to some servers.
# Every key needs its own secret. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_ADMIN=change-me

# ---- MCP servers behind the gateway -------------------------------------------
# SERVER_<ID>_URL is required. SERVER_<ID> lowercased is the tool prefix:
# SERVER_1_URL -> tools named server_1__add, server_1__echo, ...
# Optional per server:
#   _KEY             a client key that gives access to this server only
#   _TRANSPORT       streamable_http (default) or sse
#   _HEADER_<NAME>   header sent to the server; "_" becomes "-" (X_API_KEY -> X-API-KEY)
#                    (the gateway also sends X-MCP-Client: <client key name> on each client's own session)#   _TIMEOUT         seconds per request (default 60)
#   _ENABLED         false to switch off without deleting
#   _INCLUDE_TOOLS   comma-separated globs of tools to expose (default: all)
#   _EXCLUDE_TOOLS   comma-separated globs of tools to hide

SERVER_1_URL=http://127.0.0.1:9001/mcp
SERVER_1_KEY=change-me-server-1
SERVER_1_EXCLUDE_TOOLS=delete_*

SERVER_2_URL=http://127.0.0.1:9002/mcp
SERVER_2_KEY=change-me-server-2
# Header auth: server_2's token. The gateway sends it as "Authorization: Bearer <token>",
# and servers/server_2/server_2.py requires the same value.
SERVER_2_HEADER_AUTHORIZATION=change-me-server-2-token

SERVER_3_URL=http://crm-mcp.internal:9000/sse
SERVER_3_TRANSPORT=sse
SERVER_3_TIMEOUT=30
SERVER_3_ENABLED=false
