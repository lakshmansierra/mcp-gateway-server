##########################################################################
########################ADDITIONAL GATEWAY SETTINGS######################
##########################################################################


# Shared during MCP client server handshake initialization
GATEWAY_NAME=mcp-gateway
GATEWAY_VERSION=1.0.0

## http (remote clients) or stdio (a local app starts the gateway); --transport overrides it
GATEWAY_TRANSPORT=http
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_PATH=/mcp/gateway

## comma-separated host:port clients use to reach the gateway; empty = localhost only when HOST is 127.0.0.1, any Host otherwise
GATEWAY_ALLOWED_HOSTS=
GATEWAY_LOG_LEVEL=INFO
GATEWAY_AUTH_ENABLED=true  # Must send CLIENT TO GATEWAY api keys

## reconnect to a down server: first wait, doubling up to the max (seconds)
GATEWAY_RECONNECT_INITIAL_DELAY=1
GATEWAY_RECONNECT_MAX_DELAY=60

## timers (seconds)
### at startup, wait this long for servers before accepting clients
GATEWAY_STARTUP_CONNECT_TIMEOUT=10
### how often each server is health-checked and re-listed
GATEWAY_HEALTH_CHECK_INTERVAL=30
### how old the catalog may get before a list request re-fetches it
GATEWAY_CATALOG_TTL=30
### wait after a change notification, so a burst of changes becomes one refresh
GATEWAY_CHANGE_DEBOUNCE=1
### close a client's own server session after this long unused
GATEWAY_CLIENT_SESSION_IDLE=300


