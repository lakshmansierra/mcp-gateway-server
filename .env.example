# Copy to .env and fill in. .env is git-ignored, so real keys and URLs stay out of git.
# Variables already set in the real environment override values in .env.

# ---- Gateway ---------------------------------------------------------------
GATEWAY_NAME=mcp-gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_PATH=/mcp
# Comma-separated hostnames clients use to reach the gateway (DNS-rebinding protection).
# Leave empty to accept any Host header (API keys are still required).
GATEWAY_ALLOWED_HOSTS=
GATEWAY_RECONNECT_INITIAL_DELAY=1
GATEWAY_RECONNECT_MAX_DELAY=60
GATEWAY_LOG_LEVEL=INFO
GATEWAY_AUTH_ENABLED=true

# ---- Client API keys ---------------------------------------------------------
# API_KEY_<NAME>=<secret>   Clients send it as "Authorization: Bearer <secret>".
# API_KEY_<NAME>_UPSTREAMS  Optional comma-separated globs; the key only sees those upstreams.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_ADMIN=change-me
API_KEY_SUPPORT_BOT=change-me-too
API_KEY_SUPPORT_BOT_UPSTREAMS=github,docs*

# ---- Upstream MCP servers ----------------------------------------------------
# UPSTREAM_<NAME>_URL is required; <NAME> lowercased is the tool prefix (github -> "github__search_issues").
# Optional per upstream:
#   _TRANSPORT       streamable_http (default) or sse
#   _HEADER_<NAME>   header sent to the upstream; "_" becomes "-" (X_API_KEY -> X-API-KEY)
#   _TIMEOUT         seconds per request (default 60)
#   _ENABLED         false to switch off without deleting
#   _INCLUDE_TOOLS   comma-separated globs of tools to expose (default: all)
#   _EXCLUDE_TOOLS   comma-separated globs of tools to hide

UPSTREAM_GITHUB_URL=https://api.githubcopilot.com/mcp/
UPSTREAM_GITHUB_HEADER_AUTHORIZATION=Bearer your-github-token
UPSTREAM_GITHUB_INCLUDE_TOOLS=get_*,list_*,search_*

UPSTREAM_DOCS_URL=http://docs-mcp.internal:8000/mcp
UPSTREAM_DOCS_TIMEOUT=30

UPSTREAM_CRM_URL=http://crm-mcp.internal:9000/sse
UPSTREAM_CRM_TRANSPORT=sse
UPSTREAM_CRM_HEADER_X_API_KEY=your-crm-key
UPSTREAM_CRM_EXCLUDE_TOOLS=delete_*

UPSTREAM_SANDBOX_URL=http://localhost:9100/mcp
UPSTREAM_SANDBOX_ENABLED=false
