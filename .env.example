# Copy to .env and fill in. .env is git-ignored, so real keys and URLs stay out of git.
# Variables already set in the real environment override values in .env.

# ---- Gateway ---------------------------------------------------------------
# Every GATEWAY_* line is optional: a missing one falls back to the value in gateway/config.py.
GATEWAY_NAME=mcp-gateway
GATEWAY_VERSION=1.0.0
# http (remote clients) or stdio (a local app starts the gateway); --transport overrides it
GATEWAY_TRANSPORT=http
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_PATH=/mcp
# Comma-separated hostnames clients use to reach the gateway (DNS-rebinding protection).
# Leave empty to accept any Host header (API keys are still required).
GATEWAY_ALLOWED_HOSTS=
GATEWAY_LOG_LEVEL=INFO
GATEWAY_AUTH_ENABLED=true
# Reconnecting to a down server: first wait, doubling up to the max (seconds)
GATEWAY_RECONNECT_INITIAL_DELAY=1
GATEWAY_RECONNECT_MAX_DELAY=60
# Timers (seconds)
GATEWAY_STARTUP_CONNECT_TIMEOUT=10   # at startup, wait this long for servers before accepting clients
GATEWAY_HEALTH_CHECK_INTERVAL=30     # how often each server is health-checked and re-listed
GATEWAY_CATALOG_TTL=30               # how old the catalog may get before a list request re-fetches it
GATEWAY_CHANGE_DEBOUNCE=1            # wait after a change notification so a burst becomes one refresh
GATEWAY_CLIENT_SESSION_IDLE=300      # close a client's own server session after this long unused

# ---- Client API keys ---------------------------------------------------------
# Clients send a key as "Authorization: Bearer <secret>".
#   API_KEY_<NAME>=<secret>                  a key; without _SERVERS it reaches every server (admin)
#   API_KEY_<NAME>_SERVERS=server_1,server_2 a group: limits that key to one or more servers
# Every key needs its own secret. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_ADMIN=change-me

API_KEY_GROUP_1=change-me-group-1
API_KEY_GROUP_1_SERVERS=server_1

API_KEY_GROUP_2=change-me-group-2
API_KEY_GROUP_2_SERVERS=server_1, server_2

# ---- MCP servers behind the gateway -------------------------------------------
# SERVER_<ID> lowercased is the tool prefix: SERVER_1_URL -> tools named server_1__add, ...
# Every server needs all six settings below (no defaults in code; they mirror the server table):
#   _URL             the server's live MCP URL
#   _TRANSPORT       streamable_http or sse (older servers)
#   _TIMEOUT         seconds to wait for each reply
#   _ENABLED         true, or false to switch off without deleting
#   _INCLUDE_TOOLS   full tool names to expose, comma-separated (* = all tools)
#   _EXCLUDE_TOOLS   full tool names to remove from the included ones (leave empty to hide none)
# (On each client's own session the gateway also sends X-MCP-Client: <client key name>.)

SERVER_1_URL=http://127.0.0.1:9001/mcp
SERVER_1_TRANSPORT=streamable_http
SERVER_1_TIMEOUT=60
SERVER_1_ENABLED=true
SERVER_1_INCLUDE_TOOLS=*
SERVER_1_EXCLUDE_TOOLS=delete_everything

SERVER_2_URL=http://127.0.0.1:9002/mcp
SERVER_2_TRANSPORT=streamable_http
SERVER_2_TIMEOUT=60
SERVER_2_ENABLED=true
SERVER_2_INCLUDE_TOOLS=*
SERVER_2_EXCLUDE_TOOLS=

SERVER_3_URL=http://crm-mcp.internal:9000/sse
SERVER_3_TRANSPORT=sse
SERVER_3_TIMEOUT=30
SERVER_3_ENABLED=false
SERVER_3_INCLUDE_TOOLS=search_customers, get_customer
SERVER_3_EXCLUDE_TOOLS=
