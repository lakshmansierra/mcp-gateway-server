# Backend settings: copy to backend/.env and fill in. backend/.env is git-ignored; never commit real values.

# SAP HANA connection
HANA_HOST=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=
HANA_SCHEMA=

# Table names
USER_TABLE=user_mgs
MCP_SERVER_TABLE=mcp_app_mgs
MCP_CLIENT_TO_GATEWAY_API_KEY_TABLE=client_to_gateway_mcp_api_key_mgs
MCP_CLIENT_TO_GATEWAY_API_KEY_MAPPING_TABLE=client_to_gateway_mcp_api_key_mapping_mgs
REVOKED_TOKEN_TABLE=revoked_token_mgs

## frontend origins allowed to call the backend (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:5173

# BACKEND LOGIN
## signs login tokens (at least 32 random characters); changing it logs everyone out
JWT_SECRET=
## minutes a login token stays valid
JWT_EXPIRE_MINUTES=480
## required to create admins: send it as `Authorization: Bearer <key>` to POST /api/admin/register
## (empty = admin registration switched off)
ADMIN_REGISTER_KEY=
