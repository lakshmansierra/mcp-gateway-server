# Hana db creds
HANA_HOST=
HANA_PORT=
HANA_USER=
HANA_PASSWORD=
HANA_SCHEMA=

# Hana db tables 
USER_TABLE=user_mgs
MCP_SERVER_TABLE=mcp_app_mgs
MCP_CLIENT_TO_GATEWAY_API_KEY_TABLE=client_to_gateway_mcp_api_key_mgs
MCP_CLIENT_TO_GATEWAY_API_KEY_MAPPING_TABLE=client_to_gateway_mcp_api_key_mapping_mgs
REVOKED_TOKEN_TABLE=revoked_token_mgs

# frontend origins allowed to call the backend (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:5173

# backend login
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
ADMIN_REGISTER_KEY=

# gateway reload: after a change to servers, keys or users, the backend calls this so the gateway applies it at
# once; empty secret = off (the gateway then applies changes at its next periodic re-read). Same secret as
# mcp_gateway/.env; TIMEOUT = seconds to wait for the gateway's answer
GATEWAY_RELOAD_URL=http://127.0.0.1:8080/internal/reload
GATEWAY_RELOAD_SECRET=
GATEWAY_RELOAD_TIMEOUT=10
